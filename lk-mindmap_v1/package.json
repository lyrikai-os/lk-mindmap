{
  "name": "lyrikai-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LYRIKAI board — a local idea and vision board",
  "author": "Lyrikai",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && node scripts/build.mjs",
    "package": "npm run build && electron-builder --mac dir --arm64"
  },
  "build": {
    "appId": "com.lyrikai.board",
    "productName": "LYRIKAI board",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": "dir"
    },
    "fileAssociations": [
      {
        "ext": "lkmindmap",
        "name": "LYRIKAI board document",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "lucide-react": "^1.41.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "nanoid@3.3.3": "3.3.18",
    "nanoid@^4.0.2": "5.1.16",
    "lodash-es": "4.18.1"
  }
}
